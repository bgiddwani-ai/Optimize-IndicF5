# Set an image registry/repository you can push and your cluster can pull.
IMAGE=ghcr.io/your-account/indicf5-aoti:latest
NAMESPACE=indicf5
JOB_NAME=
RUN_ID=run-001
CONFIG_FILE=config.json

# Blank STORAGE_CLASS uses the cluster's default dynamic StorageClass.
STORAGE_CLASS=
STORAGE_SIZE=40Gi
CPU_REQUEST=4
CPU_LIMIT=8
MEMORY_REQUEST=16Gi
MEMORY_LIMIT=32Gi

# Optional cluster-specific settings. No node is selected by default.
RUNTIME_CLASS=
NODE_SELECTOR=
PULL_SECRET=
DNS_POLICY=ClusterFirst

# Existing Secret name, or let ./run.sh token create it with a hidden prompt.
HF_SECRET=indicf5-hf
WAIT_TIMEOUT=14400
